rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for valid ID
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny for unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Election settings
    match /settings/{settingId} {
      allow get, write: if isValidId(settingId);
      allow list: if true;
    }

    // Candidate pairs
    match /candidates/{candidateId} {
      allow get, write: if isValidId(candidateId);
      allow list: if true;
    }

    // Voters list (DPT)
    match /voters/{voterId} {
      allow get, write: if isValidId(voterId);
      allow list: if true;
    }

    // Ballots / vote records
    match /votes/{voteId} {
      allow get, write: if isValidId(voteId);
      allow list: if true;
    }
  }
}
